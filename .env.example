# Zero Gravity Environment Configuration Template
# Copy to .env and adjust values for your environment.

# ── App & Security ─────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./anti_gravity.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://zero_user:secret_pass@localhost:5432/zero_gravity

# ── Game Economy ──────────────────────────────────────────────────────────────
STARTING_BALANCE=10000
MIN_BET=10
MAX_BET=5000

# ── Game Loop Durations (seconds) ─────────────────────────────────────────────
GAME_LOOP_TICK_INTERVAL=0.05
GAME_LOOP_WAITING_DURATION=3.0
GAME_LOOP_ENDED_DURATION=2.0

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_REGISTER_PER_MINUTE=15
RATE_LIMIT_CASHOUT_PER_MINUTE=60
RATE_LIMIT_FAIRNESS_PER_MINUTE=120
RATE_LIMIT_WS_CONNECT_PER_MINUTE=30
RATE_LIMIT_WS_MESSAGES_PER_MINUTE=120
