# =============================================================================
# Anti-Gravity — Environment Configuration Template (.env)
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env files containing production secrets to version control.

# ── Application & Security ───────────────────────────────────────────────────
# "development" | "testing" | "production"
APP_ENV=development
# Generate a strong 64-character secret in production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database Configuration ───────────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./anti_gravity.db
# Production (PostgreSQL 15+):
# DATABASE_URL=postgresql+asyncpg://ag_user:ag_secure_password@localhost:5432/antigravity_db

# ── Server & Networking ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Game Defaults ─────────────────────────────────────────────────────────────
STARTING_BALANCE=10000
MIN_BET=10
MAX_BET=5000

# ── Game Loop Telemetry ───────────────────────────────────────────────────────
GAME_LOOP_TICK_INTERVAL=0.05
GAME_LOOP_WAITING_DURATION=3.0
GAME_LOOP_ENDED_DURATION=2.0

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_REGISTER_PER_MINUTE=15
RATE_LIMIT_CASHOUT_PER_MINUTE=60
RATE_LIMIT_FAIRNESS_PER_MINUTE=120
RATE_LIMIT_WS_CONNECT_PER_MINUTE=30
RATE_LIMIT_WS_MESSAGES_PER_MINUTE=120
