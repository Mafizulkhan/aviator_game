"""
Anti-Gravity — .env Template
Copy to .env and fill in your values.
"""

# App
APP_ENV=development
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./anti_gravity.db
# For production: DATABASE_URL=postgresql+asyncpg://user:pass@localhost/antigravity

# Server
HOST=0.0.0.0
PORT=8000

# Game
STARTING_BALANCE=10000
MIN_BET=10
MAX_BET=5000
