# Anti-Gravity KV — Profile Screen
#:kivy 2.3

<ProfileScreen>:
    name: "profile"
    canvas.before:
        Color:
            rgba: 0.04, 0.04, 0.10, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: [20, 20]
        spacing: 16

        BoxLayout:
            size_hint_y: None
            height: "50sp"
            Button:
                text: "‹"
                font_size: "24sp"
                size_hint_x: None
                width: "44sp"
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: 0.6, 0.6, 0.9, 1
                on_release: root.on_back()
            Label:
                text: "Profile"
                font_size: "22sp"
                bold: True
                color: 0.55, 0.25, 1, 1

        # Avatar
        Label:
            text: "🕷️"
            font_size: "72sp"
            size_hint_y: None
            height: "100sp"

        Label:
            text: root.username
            font_size: "24sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: "36sp"

        # Stats grid
        GridLayout:
            cols: 2
            spacing: [10, 12]
            size_hint_y: None
            height: self.minimum_height

            Label:
                text: "Balance"
                font_size: "15sp"
                color: 0.6, 0.6, 0.8, 1
            Label:
                text: root.current_bal + " credits"
                font_size: "15sp"
                bold: True
                color: 0.2, 1.0, 0.6, 1

            Label:
                text: "Games Played"
                font_size: "15sp"
                color: 0.6, 0.6, 0.8, 1
            Label:
                text: root.games_played
                font_size: "15sp"
                bold: True
                color: 0.9, 0.9, 1, 1

            Label:
                text: "Wins"
                font_size: "15sp"
                color: 0.6, 0.6, 0.8, 1
            Label:
                text: root.wins
                font_size: "15sp"
                bold: True
                color: 0.2, 1.0, 0.6, 1

            Label:
                text: "Losses"
                font_size: "15sp"
                color: 0.6, 0.6, 0.8, 1
            Label:
                text: root.losses
                font_size: "15sp"
                bold: True
                color: 1.0, 0.3, 0.3, 1

            Label:
                text: "Best Cash-out"
                font_size: "15sp"
                color: 0.6, 0.6, 0.8, 1
            Label:
                text: root.best_cashout
                font_size: "15sp"
                bold: True
                color: 1.0, 0.85, 0.2, 1

        Widget:
