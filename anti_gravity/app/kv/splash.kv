# Anti-Gravity KV — Splash Screen
#:kivy 2.3

<SplashScreen>:
    name: "splash"
    canvas.before:
        Color:
            rgba: 0.04, 0.04, 0.10, 1
        Rectangle:
            pos: self.pos
            size: self.size
        # Stars (static dots)
        Color:
            rgba: 1, 1, 1, 0.15
        Ellipse:
            pos: 60, 200
            size: 3, 3
        Ellipse:
            pos: 280, 480
            size: 2, 2
        Ellipse:
            pos: 150, 650
            size: 3, 3
        Ellipse:
            pos: 320, 120
            size: 2, 2
        Ellipse:
            pos: 50, 400
            size: 4, 4

    BoxLayout:
        orientation: "vertical"
        padding: [40, 0]
        spacing: 20

        Widget:
            size_hint_y: 0.3

        # Spider icon
        Label:
            text: "🕷️"
            font_size: "80sp"
            size_hint_y: None
            height: "100sp"
            opacity: root.alpha

        # Title
        Label:
            text: "ANTI-GRAVITY"
            font_size: "40sp"
            bold: True
            color: 0.55, 0.25, 1, 1
            opacity: root.alpha
            canvas.before:
                Color:
                    rgba: 0.55, 0.25, 1, 0.15 * root.alpha
                RoundedRectangle:
                    pos: self.x - 20, self.y - 8
                    size: self.width + 40, self.height + 16
                    radius: [12]

        Label:
            text: "A Spider Crash Adventure"
            font_size: "18sp"
            color: 0.6, 0.6, 0.8, 1
            opacity: root.alpha

        Widget:
            size_hint_y: 0.05

        # Loading text
        Label:
            text: "Loading…"
            font_size: "14sp"
            color: 0.4, 0.4, 0.6, 1
            opacity: root.alpha

        Widget:
            size_hint_y: 0.15
